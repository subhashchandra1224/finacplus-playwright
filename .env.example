# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real credentials.

# DemoQA credentials (create your account manually at https://demoqa.com/register)
DEMOQA_USERNAME=YOUR_USERNAME_HERE
DEMOQA_PASSWORD=YOUR_PASSWORD_HERE

# ReqRes Project API key — required for persistent Create/GET/Update workflow.
# Get your environment-scoped key (pro_* prefix) at: https://app.reqres.in/api-keys
# NOTE: The free_user_* key does NOT work for persistent collections.
REQRES_PROJECT_KEY=YOUR_PROJECT_KEY_HERE

# ReqRes collection slug to use for CRUD (default: products).
# Your starter project includes "products" by default.
# Create a custom collection at: https://app.reqres.in/collections
REQRES_COLLECTION=products
