# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real credentials.

# DemoQA credentials (create your account manually at https://demoqa.com/register)
DEMOQA_USERNAME=YOUR_USERNAME_HERE
DEMOQA_PASSWORD=YOUR_PASSWORD_HERE

# ReqRes manage key (pro_* prefix) — from https://app.reqres.in/api-keys
REQRES_PROJECT_KEY=YOUR_PROJECT_KEY_HERE

# Collection slug — create a "users" collection at https://app.reqres.in/collections
# or use "products" if you only have the default starter collection
REQRES_COLLECTION=users
